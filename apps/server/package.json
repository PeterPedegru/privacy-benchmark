{
  "name": "@pb/server",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node --enable-source-maps --enable-experimental-regexp-engine-on-excessive-backtracks dist/index.js",
    "start:src": "tsx src/index.ts",
    "build": "node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "seed:e2e": "tsx src/scripts/seed-e2e.ts",
    "eval:golden": "tsx src/scripts/eval-golden.ts",
    "bench": "node --enable-experimental-regexp-engine-on-excessive-backtracks --import tsx src/scripts/bench.ts",
    "preflight": "tsx src/scripts/preflight.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.130.0",
    "@electric-sql/pglite": "0.5.8",
    "@fontsource/inter": "^5.3.0",
    "@hono/node-server": "2.1.3",
    "@mozilla/readability": "0.6.0",
    "@pb/core": "workspace:*",
    "@pb/rubric": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "ipaddr.js": "^2.5.0",
    "linkedom": "0.18.13",
    "nanoid": "^6.0.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "satori": "0.33.5",
    "tsx": "4.23.15",
    "turndown": "7.2.4",
    "undici": "^8.11.2",
    "unpdf": "1.8.1",
    "viem": "^2.57.2",
    "zod": "4.6.5"
  }
}
