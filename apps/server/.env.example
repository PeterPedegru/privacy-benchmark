# Copy to .env and fill in. Never commit .env.

# Admin dashboard login (required for /admin). In production (NODE_ENV=production) the server refuses to start
# if it's shorter than 12 characters or a placeholder.
ADMIN_PASSWORD=
# Cookie signing secret: at least 32 random characters, e.g. `openssl rand -base64 32` (enforced in production).
# If empty, a random key is used and sessions reset on every restart. Changing ADMIN_PASSWORD signs everyone out.
SESSION_SECRET=

# Anthropic API key (model tiers below)
ANTHROPIC_API_KEY=

# Optional: raises GitHub API limits (60 → 5,000 req/h) and enables code search for the evaluator
GITHUB_TOKEN=
# Optional: the token the evaluation agents' GitHub tools use instead of GITHUB_TOKEN. Use a fine-grained token
# limited to public repositories, read-only, so instructions injected into fetched pages can't reach private repos.
GITHUB_AGENT_TOKEN=
# Optional: Etherscan lookups
ETHERSCAN_API_KEY=

# Database. Unset: PGlite (Postgres in WebAssembly) in data/pglite, or PGLITE_DIR. Set: a Postgres server.
# DATABASE_URL=postgresql://user:password@localhost:5432/benchmark
# DATABASE_PUBLIC_URL= # the production database's public URL; `railway run` supplies it to the local CLI
# PG_POOL_MAX=10
# PG_STATEMENT_TIMEOUT_MS=120000
# PGSSL=auto           # auto (TLS except on localhost and *.railway.internal), require or disable
# Who builds knowledge bases: "local" (the `pnpm bench` CLI; the production default) or "server" (this process,
# the default elsewhere).
# KB_BUILD=

# Knowledge-base research sources (optional; each one is skipped when unset or a placeholder)
# Exa: independent analyses, audits and incident reports (https://exa.ai)
EXA_API_KEY=
# NewsAPI.ai / Event Registry: news coverage (https://newsapi.ai)
NEWSAPI_AI_KEY=
# X API v2 bearer token: the project's own announcements, plus X search for the skeptic
X_BEARER_TOKEN=
# Onchain reads use public RPCs for chains 1, 10, 56, 137, 8453, 42161 and 11155111; no key is needed.
# Override or add a chain with RPC_URL_<chainId>, e.g. RPC_URL_1=https://ethereum-rpc.publicnode.com
# If a provider puts its API key in the URL, treat the whole URL as a secret: use a dedicated, read-only,
# rate-limited key for this app. RPC_URL_* values are redacted from logs, run events and model context, and RPC
# errors are reduced to a one-line reason, but a key that can't do harm is the real protection.
# Knowledge-base limits per project
KB_MAX_DOCS_PAGES=400
KB_MAX_SITE_PAGES=60
KB_MAX_CODE_FILES=800
KB_MAX_CODE_BYTES=30000000
# Repositories read from the project's GitHub orgs besides the configured ones, and their own file budget
KB_MAX_DISCOVERED_REPOS=8
KB_MAX_DISCOVERED_CODE_FILES=600
KB_MAX_DISCOVERED_CODE_BYTES=20000000
# Rebuild a knowledge base older than this many days before an evaluation
KB_STALE_DAYS=3

# Public URL of the web app (used in cards, share links and OG tags)
PUBLIC_URL=http://localhost:5173
PORT=8787

# Anthropic workspace ID: only needed if your API key is organization-level (not scoped to a workspace)
ANTHROPIC_WORKSPACE_ID=

# Model tiers (defaults shown)
#   gather: scouting sources and gathering evidence (cheap, fast)
#   write:  release triage/summaries, project summaries, intake metadata
#   reason: the code audit, judging criteria (majority votes) and the skeptic pass
MODEL_GATHER=claude-haiku-4-5
MODEL_WRITE=claude-sonnet-5-5
MODEL_REASON=claude-opus-5-5
# Per-stage overrides (optional): EVAL_MODEL_SCOUT, EVAL_MODEL_CODE, EVAL_MODEL_RESEARCH, EVAL_MODEL_JUDGE,
# EVAL_MODEL_SKEPTIC, EVAL_MODEL_SUMMARY, EVAL_MODEL_INTAKE, VERSION_MODEL

# Hand-labelled demo release (1 = on). Off by default; when off, demo data is purged on boot.
SEED_DEMO=

# Limits
EVAL_MAX_CONCURRENT_PROJECTS=2
EVAL_MAX_INFLIGHT_CALLS=6
# Spend cap per evaluation, by mode (an evaluation stops when it reaches its cap). EVAL_COST_CAP_USD still sets
# the standard cap if EVAL_COST_CAP_USD_STANDARD is unset.
EVAL_COST_CAP_USD_QUICK=10
EVAL_COST_CAP_USD_STANDARD=25
EVAL_COST_CAP_USD_DEEP=100
# Hours between automatic GitHub update checks while the server runs (0 = off)
VERSION_CHECK_INTERVAL_HOURS=12

# Database backups (apps/server/src/db/backup.ts). Before pending migrations run on a database with data, boot
# writes a logical export to backups/pre-<tag>.jsonl.gz (newest 3 kept) and refuses to migrate when the volume is
# short of space. When deployed, a daily export goes to backups/daily-YYYY-MM-DD.jsonl.gz (newest 7 kept). Restore
# one into an empty database with src/scripts/restore-export.ts.
# DB_BACKUP_DIR=            # default: backups/ next to DB_PATH
# DB_BACKUP_DAILY=          # 1 or 0 to force daily exports on or off (default: on when deployed)
# DB_BACKUP_KEEP_DAILY=7
# DB_SKIP_MIGRATION_BACKUP= # 1 = migrate without the export and space check (only after backing up yourself)
# DB_ALLOW_NEWER_SCHEMA=    # 1 = start on a database migrated by a newer build (e.g. after rolling a deploy back)
# DB_PATH=                  # the pre-Postgres SQLite database, imported once into an empty Postgres

# Extraction limits: HTML worker heap, PDF child process memory and concurrency
# KB_EXTRACT_WORKER_HEAP_MB=512
# KB_PDF_MAX_RSS_MB=768
# KB_PDF_CHILDREN=2
