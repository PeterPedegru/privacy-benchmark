{
  "name": "privacy-benchmark",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pb/web --filter @pb/server dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:migrate": "pnpm --filter @pb/server db:migrate",
    "db:seed": "pnpm --filter @pb/server db:seed",
    "seed:demo": "pnpm --filter @pb/server seed:demo",
    "seed:e2e": "pnpm --filter @pb/server seed:e2e",
    "eval:golden": "pnpm --filter @pb/server eval:golden",
    "bench": "pnpm --silent --filter @pb/server bench",
    "test:e2e": "pnpm --filter @pb/e2e test",
    "test:smoke": "pnpm --filter @pb/e2e smoke",
    "check:promises": "node apps/server/scripts/check-floating-promises.mjs",
    "test:all": "pnpm lint && pnpm typecheck && pnpm check:promises && pnpm test && pnpm test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "railway": "3.12.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
